{
  "expo": {
    "name": "whyapp",
    "slug": "whyapp",
    "version": "1.0.0",
    "scheme": "whyapp",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "us.whyapp.mobile",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "Needed for voice memos",
        "NSCameraUsageDescription": "Needed to capture documents and images",
        "NSPhotoLibraryUsageDescription": "Needed to select photos for ingestion"
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "package": "us.whyapp.mobile"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store"
    ]
  }
}
