# ── Monorepo-level exclusions (EAS archives from git root) ──
# Use ** prefix to match at any depth since EAS resolves from monorepo root
**/.git
**/.git/**
.claude
.claude/**
apps/api
apps/api/**
apps/web
apps/web/**
apps/mobile
apps/mobile/**
archive
archive/**

# ── General ──
**/node_modules
**/node_modules/**
**/.pnpm-store
**/dist
**/build
**/*.tsbuildinfo
**/.expo
**/.expo-shared

# Only ignore the top-level ios/ and android/ — those are prebuild output
# regenerated by EAS on each build. Local Expo modules live under modules/
# and their ios/ subdirectories must reach the build server.
/ios
/android

# Make sure local modules and their native sources are NOT filtered.
!modules/
!modules/**

# Dev artifacts
videos
videos/**
**/*.blend
**/*.blend1
**/*.MOV
**/*.mov
**/*.mp4
**/*.onnx
**/*.pt
**/runs
**/coverage
**/*.log

**/.wrangler
**/.dev.vars
**/.env
**/.env.*
