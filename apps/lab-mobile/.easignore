# EAS Build archive filter — paths relative to monorepo root.
# IMPORTANT: node_modules must NOT be excluded — EAS needs them to resolve
# Expo plugins during the "Read app config" phase. When .easignore exists,
# it overrides .gitignore, so we must explicitly list everything else.

**/.git
**/.git/**
.claude
.claude/**
apps/api
apps/api/**
apps/web
apps/web/**
apps/mobile
apps/mobile/**
archive
archive/**

# pnpm store (not needed; EAS uses the hoisted node_modules)
**/.pnpm-store

# Prebuild output (regenerated by EAS)
**/dist
**/*.tsbuildinfo
**/.expo
**/.expo-shared

# Only ignore the top-level ios/ and android/ — those are prebuild output.
# Local Expo modules live under modules/ and their ios/ subdirs must ship.
/ios
/android

# Make sure local modules and their native sources are NOT filtered.
!modules/
!modules/**

# Dev artifacts
**/videos
**/videos/**
**/*.blend
**/*.blend1
**/*.MOV
**/*.mov
**/*.mp4
**/*.onnx
**/*.pt
**/runs
**/coverage
**/*.log

**/.wrangler
**/.dev.vars
**/.env
**/.env.*
