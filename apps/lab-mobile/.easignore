# ── Monorepo-level exclusions (EAS archives from git root) ──
.git/
.claude/
apps/api/
apps/web/
apps/mobile/
archive/

# ── General ──
node_modules/
.pnpm-store/
dist/
build/
*.tsbuildinfo
.expo/
.expo-shared/

# Only ignore the top-level ios/ and android/ — those are prebuild output
# regenerated by EAS on each build. Local Expo modules live under modules/
# and their ios/ subdirectories must reach the build server.
/ios/
/android/

# Make sure local modules and their native sources are NOT filtered.
!modules/
!modules/**

# Dev artifacts
*.blend
*.blend1
*.onnx
*.pt
runs/
coverage/
*.log

.wrangler/
.dev.vars
.env*
