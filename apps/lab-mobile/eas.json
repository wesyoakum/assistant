{
  "cli": {
    "version": ">= 13.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "base": {
      "ios": {
        "prebuildCommand": "bash scripts/convert-baseball-model.sh"
      }
    },
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "extends": "base"
    },
    "preview": {
      "distribution": "internal",
      "channel": "preview",
      "extends": "base"
    },
    "production": {
      "autoIncrement": true,
      "channel": "production",
      "extends": "base"
    }
  },
  "submit": {
    "production": {
      "ios": {
        "ascAppId": "6773822922"
      }
    }
  }
}
